# UNI Suite — Environment Configuration Example
# Copy to .env (chmod 600) and fill strong random values before running in production.

# Required: 32+ byte random hex string (e.g. python3 -c "import secrets; print(secrets.token_hex(32))")
APP_SECRET=change-me-to-a-long-random-secret

# Optional: Admin account is ONLY created when BOTH variables are explicitly set.
# Generate Argon2id hash: .venv/bin/python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('...'))"
ADMIN_USERNAME=
HASHED_PASSWORD=

# Optional: Loopback-only internal token for Deprecation Bridge data sync (/internal/*)
INTERNAL_SYNC_TOKEN=

# Runtime & HTTP settings
UNI_HOST=127.0.0.1
UNI_PORT=5052
UNI_DB_PATH=uni.db
COOKIE_SECURE=1
TRUST_PROXY_HEADERS=1

# Optional: Tier 2 Docker sandbox (disabled by default; Tier 1 WASM runs in browser)
SANDBOX_DOCKER_ENABLED=0
